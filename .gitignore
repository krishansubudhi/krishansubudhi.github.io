# Bundler cache
.bundle
vendor

# NOTE: Gemfile.lock is deliberately NOT ignored here (the Chirpy starter ignores it).
# It is committed so Dependabot can see the resolved dependency tree and so the deploy
# workflow builds the exact versions that were tested locally.

# Jekyll cache
.jekyll-cache
.jekyll-metadata
_site

# RubyGems
*.gem

# NPM dependencies
node_modules
package-lock.json

# IDE configurations
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# Misc
_sass/vendors
assets/js/dist

# Hidden system files
*~
.DS_Store
Thumbs.db
